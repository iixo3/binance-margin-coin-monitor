# Copy to .env and fill in. .env is gitignored.

# Binance READ-ONLY key: enable "Reading" ONLY. No trade, no withdraw. IP-restrict it.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Telegram: only needed once you flip alerts_enabled=true in config.json.
# Token from @BotFather. chat_id from @userinfobot (message it, it replies your id).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
